# Backend — DEVELOPMENT template.  Copy to .env.development and fill real values.
#   cp .env.development.example .env.development
# Loaded when NODE_ENV=development (the `npm run dev` script sets this).
PORT=4000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/bug_ticket_db
UPLOAD_DIR=uploads
HERMES_AGENT_ENABLED=false
HERMES_AGENT_ENDPOINT=http://localhost:8787

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=obx-ticket
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
