# Backend — PRODUCTION template.  Copy to .env.production (or .env) on the server.
#   cp .env.production.example .env.production   # then fill real secrets
# Loaded when NODE_ENV=production (PM2 ecosystem sets this).
#
# DATABASE_URL / MINIO_SECRET_KEY must match the running postgres/minio containers.
# golive auto-syncs DATABASE_URL password from the postgres container.
PORT=4000
DATABASE_URL=postgresql://postgres:REPLACE_WITH_REAL_PASSWORD@localhost:5432/bug_ticket_db
UPLOAD_DIR=uploads
HERMES_AGENT_ENABLED=true
HERMES_AGENT_ENDPOINT=http://localhost:8787

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=REPLACE_WITH_REAL_SECRET
MINIO_BUCKET=obx-ticket
MINIO_USE_SSL=false
# set by golive to the public media tunnel, e.g. https://ticket-media.<domain>
MINIO_PUBLIC_URL=http://localhost:9000
